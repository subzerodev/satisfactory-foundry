+  typeInto($$<HTMLInputElement>(".chain-builder-controls input")[0]!, "60");
+  click(
+    $$<HTMLButtonElement>(".chain-builder-controls button").find(
+      (b) => b.textContent === "Propose",
+    )!,
+  );
