+  function planFile(name: string, recipeId: string | null): PlanFileV5 {
+    return {
+      format_version: 5,
+      name,
+      createdAt: "2026-01-01T00:00:00.000Z",
+      updatedAt: "2026-01-01T00:00:00.000Z",
