+      });
+    });
+    chooseTier("0");
+
+    expect(
+      $$<HTMLInputElement>(
+        'input[aria-label="route Resin from Fuel to Rubber"]',
+      ),
+    ).toHaveLength(0);
+    expect(
+      $$<HTMLInputElement>(
+        'input[aria-label="route Resin from Plastic to Rubber"]',
+      )[0]!.checked,
+    ).toBe(false);
+
+    act(() => {
